#!/usr/bin/env bash
# git-credential-bot - host-aware credential helper for bot identities
# Reads tokens from glab config files at runtime, never hardcoded.
#
# The script matches the requested host (from git's credential protocol)
# against hosts configured in glab config files for the selected bot.
#
# Config discovery: reads $HOME/.config/glab-<bot>/config.yml, the one config
# dir GIT_BOT names, and nothing else. A longer-named sibling such as
# glab-claude-bot-thessel is another bot, so GIT_BOT=claude never reads it (#477).
#
# Supports both YAML formats:
#   Block:  host:\n        token: ...\n        user: ...
#   Inline: host: {token: ..., user: ...}
#
# If no user is found in config, falls back to GIT_USER_NAME_<BOT>
# env var, with non-variable characters in <BOT> normalized to underscores,
# then to <bot>-bot as default.
#
# Usage:
#   GIT_BOT=claude git push    # selects claude bot, host determines identity
#   GIT_BOT=codex git push     # selects codex bot, host determines identity

operation="$1"
[ "$operation" != "get" ] && exit 0

# Read stdin (git credential protocol provides host, protocol, etc.)
REQUEST_HOST=""
while IFS='=' read -r key value; do
    [ -z "$key" ] && break
    [ "$key" = "host" ] && REQUEST_HOST="$value"
done

if [ -z "$GIT_BOT" ]; then
    echo "Error: GIT_BOT not set. Use: GIT_BOT=claude git push  or  GIT_BOT=codex git push" >&2
    exit 1
fi

if [ -z "$REQUEST_HOST" ]; then
    echo "Error: No host provided by git credential protocol" >&2
    exit 1
fi

config_file="$HOME/.config/glab-${GIT_BOT}/config.yml"

not_found() {
    echo "Error: No glab config found for GIT_BOT=$GIT_BOT and host=$REQUEST_HOST" >&2
    echo "Searched: $config_file" >&2
    exit 1
}

[ -f "$config_file" ] || not_found

# The host is compared as a literal string at the start of the line, never
# spliced into a grep pattern or awk program: as a regex its dots matched
# any character, so a request for gitlab.example.com could get the token of
# a configured gitlabXexample.com, and the host became awk source text
# (#372). It reaches awk through the environment: `awk -v` would turn an
# escape such as \056 in the value into a dot before comparing.
# Try inline format first: host: {token: ..., user: ...}
inline=$(CRED_HOST="$REQUEST_HOST" awk 'BEGIN { host = ENVIRON["CRED_HOST"] } index($0, "    " host ": {") == 1 {print; exit}' "$config_file" 2>/dev/null)
if [ -n "$inline" ]; then
    token=$(echo "$inline" | sed -n 's/.*token: *\([^ ,}]*\).*/\1/p')
    user=$(echo "$inline" | sed -n 's/.*user: *\([^ ,}]*\).*/\1/p')
else
    # Try block format: host:\n        token: ...\n        user: ...
    # The host line is matched exactly, trailing blanks allowed. The block
    # ends at the next host entry (4-space indent + non-space) or end of
    # file; host sub-keys use an 8-space indent.
    block=$(CRED_HOST="$REQUEST_HOST" awk '
        BEGIN { host = ENVIRON["CRED_HOST"] }
        !found { line = $0; sub(/[ \t]+$/, "", line); if (line == "    " host ":") found = 1; next }
        /^    [^ ]/ { exit }
        { print }
        END { if (!found) exit 1 }' "$config_file" 2>/dev/null) || not_found
    token=$(echo "$block" | awk '/token:/{print $2; exit}')
    user=$(echo "$block" | awk '/user:/{print $2; exit}')
fi

# If we found a token, we have a match
if [ -n "$token" ]; then
    # Fallback for user: env var, then derive from bot name
    if [ -z "$user" ]; then
        bot_env=$(printf '%s' "$GIT_BOT" | tr '[:lower:]' '[:upper:]' | sed 's/[^A-Z0-9_]/_/g')
        user_var="GIT_USER_NAME_${bot_env}"
        user="${!user_var:-}"
    fi
    if [ -z "$user" ]; then
        user="${GIT_BOT}-bot"
    fi

    echo "username=$user"
    echo "password=$token"
    exit 0
fi

not_found
