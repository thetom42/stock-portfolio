      "Bash(just mr-view:*)",
      "Bash(just pr-list)",
      "Bash(just pr-view:*)",
      "Bash(just ci-status)",
      "Bash(just ci-jobs:*)",
      "Bash(just ci-logs:*)",
      "Bash(just ci-list:*)",
      "Bash(just labels)",
      "Bash(just info)",
      "Bash(just browse)",
      "Bash(just whoami)",
      "Bash(just version)",
      "Bash(just services)",
      "Bash(just hosts:*)",
      "Bash(just vars:*)",
      "Bash(just playbooks:*)",
      "Bash(just workflows)",
      "Bash(just release-list)",
      "Bash(just deps-outdated)",
      "Bash(git status)",
      "Bash(git diff:*)",
